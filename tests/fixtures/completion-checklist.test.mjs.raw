 const historical=structuredClone(data);delete historical.pendingAtlasSource;const rendered=renderChecklist(historical);assert(!rendered.includes('Pending Atlas source:'));assert(rendered.includes(historical.baseline.atlasCommit));assert.equal(historical.items.length,71);
});

test('immutable revision30 imports only36 hand X-ray drafts and preserves the complete roadmap',()=>{
 const data=revision30Data;
 assert.equal(data.revision,30);assert.equal(data.updatedAt,'2026-10-16');
 assert.deepEqual(data.items,revision29Data.items);assert.deepEqual(data.changeLog.slice(1),revision29Data.changeLog);
 assert.equal(data.baseline.atlasCommit,'f1dc0ccc54ec82aa774720db3c822d3e0ea9c418');assert.equal(data.baseline.atlasTree,'d3c165a126e773f004c9a620b5271bc15d0f384a');
 assert.equal(data.baseline.reviewIntegration,'bbca7076adc53030a83772c457d2dec50aac6622defb45ce2c5510464f926297');assert.equal(data.baseline.reviewSourceFiles,1508);
 const excluded=['atlasCommit','atlasTree','reviewIntegration','reviewSourceFiles','rootDraftPlacements','rootPendingPlacements'];
 const omit=o=>Object.fromEntries(Object.entries(o).filter(([k])=>!excluded.includes(k)));
 assert.deepEqual(omit(data.baseline),omit(revision29Data.baseline));
 assert.equal(data.baseline.rootDraftPlacements-revision29Data.baseline.rootDraftPlacements,36);assert.equal(revision29Data.baseline.rootPendingPlacements-data.baseline.rootPendingPlacements,36);
 assert.equal(data.baseline.rootGeneratedIdentificationPlacements,39);assert.equal(data.baseline.publicReleaseApproval,null);
 assert.equal(data.pendingAtlasSource.commit,data.baseline.atlasCommit);assert.equal(data.pendingAtlasSource.tree,data.baseline.atlasTree);
 assert.equal(data.pendingAtlasSource.websiteImported,true);assert.match(data.pendingAtlasSource.note,/radiologist/);
 for(const path of ['atlas-cervical-source-transition','current-atlas-delivery']){
 const frozen=readFileSync('tests/fixtures/'+path+'-8d32653e.txt');
 const pins={"atlas-cervical-source-transition":"e61db2a3c1aba559a28e78302e89bb8ddb534104fe368d7392562d3707b53deb","current-atlas-delivery":"3ee1af7669fe7b97050e11397867e233b7e91e02fe1ae50fe46ff08a8e31da8b"};
 assert.equal(createHash('sha256').update(frozen).digest('hex'),pins[path]);}
 for(const edit of [p=>{p.websiteImported=false;},p=>{p.commit='0'.repeat(40);},p=>{p.rootDraftPlacements++;},p=>{p.clinicalApproval=true;}]){const bad=structuredClone(data);edit(bad.pendingAtlasSource);assert.throws(()=>validateChecklist(bad));}
 assert(renderChecklist(data).includes('9294 editorial drafts, 603 pending and 39 generated'));
});

test('immutable revision31 adds only bounded release-epoch repair evidence',()=>{
 const bytes=readFileSync(new URL('./fixtures/completion-checklist-31.json',import.meta.url));
 assert.equal(createHash('sha256').update(bytes).digest('hex'),'17870b881cf01a3e214dfcfb55390837e752c54171353e18851cbddce4e08c32');
 const data=JSON.parse(bytes);
 assert.equal(data.revision,31);assert.equal(data.updatedAt,'2026-10-16');assert.deepEqual(data.baseline,revision30Data.baseline);assert.deepEqual(data.pendingAtlasSource,revision30Data.pendingAtlasSource);
 assert.equal(data.items.length,71);assert.equal(data.items.filter(i=>i.scope==='optional').length,8);
 for(const old of revision30Data.items){const now=data.items.find(i=>i.id===old.id);assert(now);if(old.id==='REL-01'){const {evidence:a,...previous}=old,{evidence:b,...current}=now;assert.deepEqual(current,previous);assert.equal(now.status,'partial');assert.deepEqual(b,[...a,'website:docs/DELIVERY_EPOCH_REPAIR.md']);}else assert.deepEqual(now,old);}
 assert.deepEqual(data.changeLog.slice(1),revision30Data.changeLog);assert.equal(data.changeLog[0].revision,31);assert.match(data.changeLog[0].change,/incomplete whole-suite/);assert.equal(data.baseline.publicReleaseApproval,null);assert(renderChecklist(data).includes('Revision 31'));
});

test('immutable revision32 preserves complete scope and adds only correction recovery evidence',()=>{
 const bytes=readFileSync(new URL('./fixtures/completion-checklist-32.json',import.meta.url));
 assert.equal(createHash('sha256').update(bytes).digest('hex'),'13c3e726381a54618a7b98de8420cd3d5b09c714adc0e4a1dc16206383d446ae');
 const data=JSON.parse(bytes);
 const before=JSON.parse(readFileSync(new URL('./fixtures/completion-checklist-31.json',import.meta.url)));
 assert.equal(data.revision,32);assert.deepEqual(data.baseline,before.baseline);assert.deepEqual(data.pendingAtlasSource,before.pendingAtlasSource);
 assert.equal(data.items.length,71);assert.equal(data.items.filter(i=>i.scope==='optional').length,8);
 for(const old of before.items){const now=data.items.find(i=>i.id===old.id);assert(now);
  if(old.id==='STUDIO-04'){const {evidence:a,...previous}=old,{evidence:b,...current}=now;assert.deepEqual(current,previous);assert.equal(now.status,'partial');assert.deepEqual(b,[...a,'website:tests/workbook-correction-lookup-api.test.mjs']);}
  else assert.deepEqual(now,old);
 }
 assert.deepEqual(data.changeLog.slice(1),before.changeLog);assert.equal(data.changeLog[0].revision,32);
 assert.match(data.changeLog[0].change,/manual exact-request correction creation status recovery/i);
 assert.match(data.changeLog[0].change,/incomplete whole-suite/);assert.equal(data.baseline.publicReleaseApproval,null);
 assert(renderChecklist(data).includes('Revision 32'));
});

test('immutable revision33 keeps pending intracranial-US source separate from the running website',()=>{
 const bytes=readFileSync(new URL('./fixtures/completion-checklist-33.json',import.meta.url));
 assert.equal(createHash('sha256').update(bytes).digest('hex'),'cdf86caa6c2032eb37cc08ccda30ea2b6694ee3940356862674da9086e706331');
 const data=JSON.parse(bytes);
 const before=JSON.parse(readFileSync(new URL('./fixtures/completion-checklist-32.json',import.meta.url)));
 assert.equal(data.revision,33);assert.deepEqual(data.baseline,before.baseline);
 const p=data.pendingAtlasSource,b=data.baseline;assert.equal(p.websiteImported,false);
 assert.equal(p.commit,'589263554141ba94548f9073327d4e51674bc33b');assert.equal(p.tree,'ba724f0a46448132a6e5fc4c24f63730b53540f9');
 assert.equal(b.atlasCommit,'f1dc0ccc54ec82aa774720db3c822d3e0ea9c418');
 assert.equal(p.rootDraftPlacements-b.rootDraftPlacements,8);assert.equal(b.rootPendingPlacements-p.rootPendingPlacements,8);
 assert.equal(p.rootGeneratedIdentificationPlacements,b.rootGeneratedIdentificationPlacements);
 assert.equal(data.items.length,71);assert.equal(data.items.filter(i=>i.scope==='optional').length,8);
 for(const old of before.items){const now=data.items.find(i=>i.id===old.id);assert(now);
  if(old.id==='TEACH-01'){const {status:a,evidence:c,...oldScope}=old,{status:z,evidence:d,...scope}=now;
   assert.deepEqual(scope,oldScope);assert.equal(a,'open');assert.equal(z,'partial');assert.deepEqual(d,[...c,'atlas:docs/INTRACRANIAL_ARTERIAL_ULTRASOUND.md']);
  }else assert.deepEqual(now,old);
 }
 assert.deepEqual(data.changeLog.slice(1),before.changeLog);assert.equal(data.baseline.publicReleaseApproval,null);
 const view=renderChecklist(data);assert(view.includes('Pending Atlas source:'));assert(view.includes('Not imported into the website baseline above.'));
 for(const edit of [p=>{p.websiteImported=true;},p=>{p.commit=b.atlasCommit;},p=>{p.rootDraftPlacements++;},p=>{p.clinicalApproval=true;}]){
  const bad=structuredClone(data);edit(bad.pendingAtlasSource);assert.throws(()=>validateChecklist(bad));
 }
});

