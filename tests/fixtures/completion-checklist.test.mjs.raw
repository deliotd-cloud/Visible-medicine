test('completion register preserves 71 stable bounded items and eight separate optional ideas',()=>{
 assert.equal(validateChecklist(data),data);assert.equal(data.items.length,71);assert.equal(new Set(data.items.map(i=>i.id)).size,71);assert.equal(data.items.filter(i=>i.scope==='optional').length,8);
 const rendered=renderChecklist(data);for(const item of data.items)assert(rendered.includes('**'+item.id+' '));assert(rendered.includes('not unique lessons'));assert(rendered.includes('clinical sign-off'));assert(rendered.includes('## Your next inputs'));
});
for(const [label,mutate]of [
 ['duplicate IDs',d=>{d.items[1].id=d.items[0].id;}],
 ['unknown status',d=>{d.items[0].status='approved';}],
 ['proposal as mandatory requirement',d=>{const i=d.items.find(i=>i.status==='proposed');i.scope='release-essential';}],
 ['done without a completion record',d=>{d.items[0].status='done';}],
 ['missing evidence',d=>{d.items[0].evidence=[];}],
 ['unsafe private locator',d=>{d.items[0].evidence=['website:.local/patient.json'];}],
 ['missing current change log',d=>{d.revision=data.revision+1;}],
 ])test('completion register rejects '+label,()=>{const changed=structuredClone(data);mutate(changed);assert.throws(()=>validateChecklist(changed));});
test('evidence references cannot escape source roots',()=>{for(const ref of ['website:../secret','website:/secret','unknown:docs/file.md','website:.env.local'])assert.throws(()=>evidencePath(data,ref));});

test('pending source is displayed separately from the unchanged website baseline',()=>{
 const data=historicalData;
 const rendered=renderChecklist(data);assert(rendered.includes('Pending Atlas source:'));assert(rendered.includes(data.pendingAtlasSource.commit));assert(rendered.includes(data.baseline.atlasCommit));assert(rendered.includes('Not imported into the website baseline above.'));assert(rendered.includes('Canonical Atlas summaries were refreshed'));assert(!rendered.includes('Some older canonical Atlas summaries are stale'));
});
test('pending source cannot imply an import, expanded scope or approval',()=>{
 const data=historicalData;
 for(const edit of [p=>{p.websiteImported=true;},p=>{p.commit=data.baseline.atlasCommit;},p=>{p.tree='HEAD';},p=>{p.rootDraftPlacements++;},p=>{p.rootPendingPlacements=-1;},p=>{p.clinicalApproval=true;}]){const changed=structuredClone(data);edit(changed.pendingAtlasSource);assert.throws(()=>validateChecklist(changed));}
});

test('revision21 imported source agrees exactly with baseline and retains every roadmap item status',()=>{
 const data=integratedData;
 assert.equal(data.pendingAtlasSource.websiteImported,true);assert.equal(data.pendingAtlasSource.commit,data.baseline.atlasCommit);
 const html=renderChecklist(data);assert(html.includes('Integrated Atlas source:'));assert(html.includes('**Imported into the website baseline above.**'));assert(!html.includes('Not imported into the website baseline above.'));
 assert.deepEqual(data.items.map(i=>[i.id,i.status]),historicalData.items.map(i=>[i.id,i.status]));
 for(const edit of [p=>{p.commit='0'.repeat(40);},p=>{p.tree='0'.repeat(40);},p=>{p.rootDraftPlacements++;p.rootPendingPlacements--;},p=>{p.websiteImported=false;},p=>{p.clinicalApproval=true;}]){
  const changed=structuredClone(data);edit(changed.pendingAtlasSource);assert.throws(()=>validateChecklist(changed));
 }
});

test('revision22 four-draft source candidate stays distinct from unchanged integrated baseline',()=>{
 const data=pendingData;
 assert.equal(data.revision,22);assert.equal(data.pendingAtlasSource.websiteImported,false);
 assert.deepEqual(data.baseline,integratedData.baseline);
 assert.deepEqual(data.items,integratedData.items,'All roadmap items, statuses and evidence remain');
 const p=data.pendingAtlasSource,b=data.baseline;
 assert.equal(p.commit,'408759d57644b05402e98a937e7cf6338b5509cf');
 assert.equal(p.tree,'8386a10eb2bf80393233a7afe04447b2778877cd');
 assert.equal(p.rootDraftPlacements-b.rootDraftPlacements,4);
 assert.equal(b.rootPendingPlacements-p.rootPendingPlacements,4);
 assert.equal(p.rootGeneratedIdentificationPlacements,b.rootGeneratedIdentificationPlacements);
 const rendered=renderChecklist(data);assert(rendered.includes('Pending Atlas source:'));
 assert(rendered.includes('Not imported into the website baseline above.'));
 for(const mutate of [p=>{p.websiteImported=true;},p=>{p.commit=b.atlasCommit;},
   p=>{p.rootDraftPlacements++;},p=>{p.clinicalApproval=true;}]) {
   const bad=structuredClone(data);mutate(bad.pendingAtlasSource);assert.throws(()=>validateChecklist(bad));
 }
});

test('historical revision23 integrated four-draft source conserves scope and every roadmap item',()=>{
 const data=revision23Data;
 assert.equal(data.revision,23);assert.equal(data.pendingAtlasSource.websiteImported,true);
 assert.deepEqual(data.items,pendingData.items);
 const b=data.baseline,p=data.pendingAtlasSource;
 assert.equal(b.atlasCommit,p.commit);assert.equal(b.atlasTree,p.tree);
 assert.equal(b.atlasCommit,pendingData.pendingAtlasSource.commit);
 assert.equal(b.reviewIntegration,'8dd5e6e581621da7cfef475456d8cab8e458caefe91b990e31b898dbffd5117a');
 assert.equal(b.reviewSourceFiles,1499);
 assert.equal(b.rootDraftPlacements,9196);assert.equal(b.rootPendingPlacements,701);assert.equal(b.rootGeneratedIdentificationPlacements,39);
 assert.equal(b.rootTopicPlacements,pendingData.baseline.rootTopicPlacements);
 assert.equal(b.rootDraftPlacements-pendingData.baseline.rootDraftPlacements,4);
 assert.equal(pendingData.baseline.rootPendingPlacements-b.rootPendingPlacements,4);
 for(const key of ['rootRepresentations','nestedRepresentations','nestedConcepts','regionalTours','regionalTourStops','independentGuides','independentGuideStops'])
  assert.equal(b[key],pendingData.baseline[key],key+' scope unchanged');
 const rendered=renderChecklist(data);assert(rendered.includes('Integrated Atlas source:'));
 assert(rendered.includes('**Imported into the website baseline above.**'));
 for(const mutate of [p=>{p.websiteImported=false;},p=>{p.tree='0'.repeat(40);},
  p=>{p.rootDraftPlacements++;p.rootPendingPlacements--;},p=>{p.clinicalApproval=true;}]){
  const bad=structuredClone(data);mutate(bad.pendingAtlasSource);assert.throws(()=>validateChecklist(bad));
 }
});

test('historical revision24 lecture intake records partial progress without shrinking any roadmap acceptance',()=>{
 const data=revision24Data;
 assert.equal(data.revision,24);assert.equal(data.items.length,revision23Data.items.length);
 const changedIds=['TEACH-11','IMG-04','STUDIO-02'];
 for(const prior of revision23Data.items){
  const current=data.items.find(item=>item.id===prior.id);assert(current);
  if(changedIds.includes(prior.id)){
   assert.equal(prior.status,'open');assert.equal(current.status,'partial');
   const {status:oldStatus,evidence:oldEvidence,...oldScope}=prior;
   const {status:newStatus,evidence:newEvidence,...newScope}=current;
   assert.deepEqual(newScope,oldScope);assert(oldEvidence.every(ref=>newEvidence.includes(ref)));
  }else assert.deepEqual(current,prior);
 }
 const {reviewIntegration:oldReview,...oldBaseline}=revision23Data.baseline;
 const {reviewIntegration:newReview,...newBaseline}=data.baseline;
 assert.equal(oldReview,'8dd5e6e581621da7cfef475456d8cab8e458caefe91b990e31b898dbffd5117a');
 assert.equal(newReview,'8b17f3fdc1761867e0acea6fe6df171c8213f3fc6043b8c223fc17d9bd0ae259');
 assert.deepEqual(newBaseline,oldBaseline);assert.deepEqual(data.pendingAtlasSource,revision23Data.pendingAtlasSource);
 assert.equal(data.items.find(item=>item.id==='TEACH-10').status,'needs-owner');
 assert.equal(data.items.filter(item=>item.scope==='optional').length,8);
});
test('historical revision25 imports the exact cervical source and adds only retirement evidence',()=>{
 const data=revision25Data;
 assert.equal(data.revision,25);assert.equal(data.updatedAt,'2026-10-16');
 const old=revision24Data.baseline,current=data.baseline;
 assert.equal(current.atlasCommit,'4e9f53851cdc55b89ca8bfc1b6d07e19445fc2ad');
 assert.equal(current.atlasTree,'4a4994524f37561afa0ac6d66cff99ad48fbde92');
 assert.equal(current.reviewIntegration,'fbd42e2390faa0a77a5e70393660cbdd56a494f290e6153558356c5252844cb8');
 assert.equal(current.reviewSourceFiles,1502);
 assert.equal(current.rootDraftPlacements,9202);assert.equal(current.rootPendingPlacements,695);
 assert.equal(current.rootGeneratedIdentificationPlacements,39);
 assert.equal(current.rootDraftPlacements-old.rootDraftPlacements,6);
 assert.equal(old.rootPendingPlacements-current.rootPendingPlacements,6);
 const changedBaselineKeys=['atlasCommit','atlasTree','reviewIntegration','reviewSourceFiles','rootDraftPlacements','rootPendingPlacements'];
 for(const key of Object.keys(old))if(!changedBaselineKeys.includes(key))assert.deepEqual(current[key],old[key],key+' unchanged');
 const source=data.pendingAtlasSource;
 assert.equal(source.commit,current.atlasCommit);assert.equal(source.tree,current.atlasTree);
 assert.equal(source.rootDraftPlacements,current.rootDraftPlacements);
 assert.equal(source.rootPendingPlacements,current.rootPendingPlacements);
 assert.equal(source.rootGeneratedIdentificationPlacements,current.rootGeneratedIdentificationPlacements);
 assert.equal(source.websiteImported,true);
 assert.equal(source.evidence,'F:/VisibleMedicine/staging/20261016-cervical-xray/canonical-installed.json');
 assert.equal(current.rootDraftPlacements+current.rootPendingPlacements+current.rootGeneratedIdentificationPlacements,current.rootTopicPlacements);
 assert.equal(data.items.length,71);assert.equal(data.items.filter(i=>i.scope==='optional').length,8);
 for(const prior of revision24Data.items){
  const item=data.items.find(i=>i.id===prior.id);assert(item);
  if(item.id==='STUDIO-04'){
   const {evidence:before,...priorRest}=prior,{evidence:after,...itemRest}=item;
   assert.deepEqual(itemRest,priorRest);
   assert.deepEqual(after,[...before,'website:docs/STUDIO_WORKBOOK_RETIREMENT.md']);
  }else assert.deepEqual(item,prior,item.id+' unchanged');
 }
 assert.equal(data.items.find(i=>i.id==='STUDIO-04').status,'partial');
 assert.deepEqual(data.changeLog.slice(1),revision24Data.changeLog);
 assert.equal(data.changeLog[0].revision,25);
 assert.match(data.changeLog[0].change,/correction\/supersession.*remain open/i);
 const rendered=renderChecklist(data);
 assert(rendered.includes('Integrated Atlas source:'));
 assert(rendered.includes('**Imported into the website baseline above.**'));
 assert(rendered.includes('9202 editorial drafts, 695 pending and 39 generated'));
});
test('current revision26 adds only exact Review identity and bounded guided lecture evidence',()=>{
 const data=revision26Data;
 assert.equal(data.revision,26);assert.equal(data.updatedAt,'2026-10-16');
 const {reviewIntegration:priorReview,...priorBaseline}=revision25Data.baseline;
 const {reviewIntegration:currentReview,...currentBaseline}=data.baseline;
 assert.equal(priorReview,'fbd42e2390faa0a77a5e70393660cbdd56a494f290e6153558356c5252844cb8');
 assert.equal(currentReview,'582710a1e67c3f1c10e632a6c402335d191b39e13f97f9e5c55d1662d20f20d9');
 assert.deepEqual(currentBaseline,priorBaseline);
 assert.deepEqual(data.pendingAtlasSource,revision25Data.pendingAtlasSource);
 assert.equal(data.items.length,71);assert.equal(data.items.filter(item=>item.scope==='optional').length,8);
 for(const prior of revision25Data.items){
  const current=data.items.find(item=>item.id===prior.id);assert(current);
  if(prior.id==='IMG-04'){
   const {evidence:before,...priorScope}=prior,{evidence:after,...currentScope}=current;
   assert.deepEqual(currentScope,priorScope,'IMG-04 status and acceptance stay partial and unchanged');
   assert.deepEqual(after,[...before,'website:docs/GUIDED_LECTURE_HANDOFF.md']);
  }else assert.deepEqual(current,prior,prior.id+' unchanged');
 }
 assert.deepEqual(data.changeLog.slice(1),revision25Data.changeLog);
 assert.equal(data.changeLog[0].revision,26);
 assert.match(data.changeLog[0].change,/Lecture access remains independent from Atlas access/);
 assert.match(data.changeLog[0].change,/do not establish signed-in browser acceptance, clinical approval, patient registration or public release/);
 const rendered=renderChecklist(data);
 assert(rendered.includes('Revision 26'));
 assert(rendered.includes(currentReview));
 assert(rendered.includes('GUIDED_LECTURE_HANDOFF.md'));
});
test('immutable revision27 imports only 56 exact-source spinal X-ray drafts and preserves the roadmap',()=>{
 const data=revision27Data;
 assert.equal(createHash('sha256').update(readFileSync(new URL('./fixtures/clinical-review-manifest-8d32653e.json',import.meta.url))).digest('hex'),'2066b4d9abd2e0a90f546c42025eca2284ab9623f67340d51ee31e19a4082e23');
 assert.equal(createHash('sha256').update(readFileSync(new URL('./fixtures/clinical-review-viewer-8d32653e.json',import.meta.url))).digest('hex'),'f5295d676c647aa2574171854d5559362261f7cb578c0bb5deeea02d69f02431');
 assert.equal(data.revision,27);assert.equal(data.updatedAt,'2026-10-16');
 const old=revision26Data.baseline,current=data.baseline;
 assert.equal(current.atlasCommit,'8d32653eaac8b86521618c824214dd6af8e35e29');
 assert.equal(current.atlasTree,'876d7c8b59a9507479b65e1800c2bea455b242ef');
 assert.match(current.reviewIntegration,/^[a-f0-9]{64}$/);
 assert.equal(current.reviewSourceFiles,1505);
 assert.equal(current.rootDraftPlacements,9258);
 assert.equal(current.rootPendingPlacements,639);
 assert.equal(current.rootGeneratedIdentificationPlacements,39);
 assert.equal(current.rootDraftPlacements-old.rootDraftPlacements,56);
 assert.equal(old.rootPendingPlacements-current.rootPendingPlacements,56);
 assert.equal(current.rootDraftPlacements+current.rootPendingPlacements+
  current.rootGeneratedIdentificationPlacements,current.rootTopicPlacements);
 const changed=['atlasCommit','atlasTree','reviewIntegration','reviewSourceFiles',
  'rootDraftPlacements','rootPendingPlacements'];
 for(const key of Object.keys(old))if(!changed.includes(key))
  assert.deepEqual(current[key],old[key],key+' unchanged');
 const review=JSON.parse(readFileSync(new URL('./fixtures/clinical-review-manifest-8d32653e.json',import.meta.url)));
 const viewer=JSON.parse(readFileSync(new URL('./fixtures/clinical-review-viewer-8d32653e.json',import.meta.url)));
 assert.equal(review.revision,current.atlasCommit);
 assert.equal(review.files.length,current.reviewSourceFiles);
 assert.equal(review.packages.length,14);
 for(const path of ['lib/spinal-muscle-xray.ts','content/spinal-muscle-xray.ts',
  'content/spinal-muscle-xray-pins.json']){
  const entry=review.files.filter(file=>file.path===path);
  assert.equal(entry.length,1,path+' exact Review source');
  assert.match(entry[0].sourceSha256,/^[a-f0-9]{64}$/);
  assert.match(entry[0].importedSha256,/^[a-f0-9]{64}$/);
 }
 assert.equal(viewer.sourceCommit,current.atlasCommit);
 assert.equal(viewer.websiteIntegrationSha256,current.reviewIntegration);
 assert.equal(viewer.mode,'production');
 assert.equal(viewer.files.length,46);assert.equal(viewer.packages.length,22);
 assert.equal(viewer.personalRecordsIncluded,false);
 const source=data.pendingAtlasSource;
 assert.equal(source.commit,current.atlasCommit);
 assert.equal(source.tree,current.atlasTree);
 assert.equal(source.rootDraftPlacements,current.rootDraftPlacements);
 assert.equal(source.rootPendingPlacements,current.rootPendingPlacements);
 assert.equal(source.rootGeneratedIdentificationPlacements,current.rootGeneratedIdentificationPlacements);
 assert.equal(source.websiteImported,true);
 assert.equal(source.evidence,'F:/VisibleMedicine/staging/20261016-spinal-muscle-xray/canonical-installed.json');
 assert.match(source.note,/56/);assert.match(source.note,/radiologist/i);
 assert.match(source.note,/draft/i);
 assert.deepEqual(data.items,revision26Data.items,'All 71 statuses, acceptance and evidence remain exact');
 assert.equal(data.items.length,71);
 assert.equal(data.items.filter(item=>item.scope==='optional').length,8);
 assert.deepEqual(data.changeLog.slice(1),revision26Data.changeLog);
 assert.equal(data.changeLog[0].revision,27);
 assert.equal(data.changeLog[0].date,'2026-10-16');
 assert.match(data.changeLog[0].change,/56/);
 assert.match(data.changeLog[0].change,/clinical approval/i);
 for(const mutate of [p=>{p.websiteImported=false;},p=>{p.commit='0'.repeat(40);},
  p=>{p.rootDraftPlacements++;p.rootPendingPlacements--;},p=>{p.clinicalApproval=true;}]){
  const bad=structuredClone(data);mutate(bad.pendingAtlasSource);assert.throws(()=>validateChecklist(bad));
 }
 const rendered=renderChecklist(data);
 assert(rendered.includes('Revision 27'));
 assert(rendered.includes(current.reviewIntegration));
 assert(rendered.includes('9258 editorial drafts, 639 pending and 39 generated'));
 assert(rendered.includes('**Imported into the website baseline above.**'));
});
test('immutable revision28 records only bounded REL-01 delivery evidence and retains all release gates',()=>{
 const data=revision28Data;
 assert.equal(data.revision,28);assert.equal(data.updatedAt,'2026-10-16');
 assert.deepEqual(data.baseline,revision27Data.baseline,'Atlas, Review and runtime baseline stay exact');
 assert.deepEqual(data.pendingAtlasSource,revision27Data.pendingAtlasSource,'pending source stays exact');
 assert.equal(data.items.length,71);assert.equal(data.items.filter(item=>item.scope==='optional').length,8);
 for(const prior of revision27Data.items){
  const current=data.items.find(item=>item.id===prior.id);assert(current,prior.id);
  if(prior.id==='REL-01'){
   const {evidence:before,...priorScope}=prior,{evidence:after,...currentScope}=current;
   assert.deepEqual(currentScope,priorScope,'REL-01 scope, partial status and acceptance stay exact');
   assert.equal(current.status,'partial');
   assert.deepEqual(after,[...before,'website:docs/CURRENT_ATLAS_TEST_DELIVERY.md']);
  }else assert.deepEqual(current,prior,prior.id+' unchanged');
 }
 assert.deepEqual(data.changeLog.slice(1),revision27Data.changeLog,'all earlier change log entries stay exact');
 assert.equal(data.changeLog[0].revision,28);assert.equal(data.changeLog[0].date,'2026-10-16');
 assert.match(data.changeLog[0].change,/exact current.*delivery.*fixture/i);
 assert.match(data.changeLog[0].change,/immutable historical.*proof/i);
 assert.match(data.changeLog[0].change,/full.*suite.*incomplete/i);
 assert.equal(data.baseline.publicReleaseApproval,null);
 assert.notEqual(data.pendingAtlasSource.clinicalApproval,true);
 const rendered=renderChecklist(data);
 assert(rendered.includes('Revision 28'));
 assert(rendered.includes('CURRENT_ATLAS_TEST_DELIVERY.md'));
 assert(rendered.includes('9258 editorial drafts, 639 pending and 39 generated'));
});
test('immutable revision29 records correction preparation without claiming replacement or release',()=>{
 const data=revision29Data;
 assert.equal(data.revision,29);assert.equal(data.updatedAt,'2026-10-16');
 assert.deepEqual(data.baseline,revision28Data.baseline);
 assert.deepEqual(data.pendingAtlasSource,revision28Data.pendingAtlasSource);
 assert.equal(data.items.length,71);assert.equal(data.items.filter(item=>item.scope==='optional').length,8);
 for(const prior of revision28Data.items){
  const current=data.items.find(item=>item.id===prior.id);assert(current);
  if(prior.id==='STUDIO-04'){
   const {evidence:before,...oldScope}=prior,{evidence:after,...scope}=current;
   assert.deepEqual(scope,oldScope);assert.equal(current.status,'partial');
   assert.deepEqual(after,[...before,'website:docs/STUDIO_WORKBOOK_CORRECTIONS.md']);
  }else assert.deepEqual(current,prior,prior.id+' remains exact');
 }
 assert.deepEqual(data.changeLog.slice(1),revision28Data.changeLog);
 assert.equal(data.changeLog[0].revision,29);
 assert.match(data.changeLog[0].change,/correction drafts.*teaching, assessment and lecture/i);
 assert.match(data.changeLog[0].change,/replacement.*separate/i);
 assert.match(data.changeLog[0].change,/STUDIO-04 stays partial/i);
 assert.equal(data.baseline.publicReleaseApproval,null);
 assert.notEqual(data.pendingAtlasSource.clinicalApproval,true);
 const rendered=renderChecklist(data);assert(rendered.includes('Revision 29'));
 assert(rendered.includes('STUDIO_WORKBOOK_CORRECTIONS.md'));
});

