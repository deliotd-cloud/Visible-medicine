test('immutable revision38 records installed safety evidence without advancing a broader requirement',()=>{
 const data=revision38Data;
 const before=JSON.parse(readFileSync(new URL('./fixtures/completion-checklist-37.json',import.meta.url)));
 assert.equal(data.revision,38);assert.equal(data.items.length,71);assert.equal(data.items.filter(i=>i.scope==='optional').length,8);
 assert.deepEqual(data.changeLog.slice(1),before.changeLog);assert.equal(data.changeLog[0].revision,38);
 assert.deepEqual({...data.baseline,reviewIntegration:before.baseline.reviewIntegration},before.baseline);
 assert.equal(data.baseline.reviewIntegration,'4fb502a3edb0a95e73fb154ccb5e7c720dab862d71c2b4230a6092ba530424b9');
 const expected={
  'CORE-03':['website:docs/HEAD_LOADING_RELIABILITY.md'],
  'IMG-01':['website:docs/HEAD_LOADING_RELIABILITY.md'],
  'UX-01':['delivery:checkpoint.json'],
  'STUDIO-01':['website:lib/studio-mutation-context.ts','delivery:checkpoint.json'],
  'STUDIO-03':['website:lib/studio-mutation-context-server.ts'],
  'REL-01':['delivery:checkpoint.json'],
  'REL-05':['website:lib/studio-mutation-context.ts','website:lib/studio-mutation-context-server.ts','delivery:checkpoint.json'],
  'REL-07':['delivery:final-source-manifest.json','delivery:checkpoint.json'],
 };
 for(const prior of before.items){const now=data.items.find(i=>i.id===prior.id);assert(now);const{evidence:a,...old}=prior,{evidence:b,...current}=now;assert.deepEqual(current,old,'Requirement/acceptance/status changed: '+prior.id);assert.deepEqual(b,[...a,...expected[prior.id]??[]]);}
 const{delivery,...roots}=data.roots;assert.deepEqual(roots,before.roots);assert.equal(delivery,'F:/VisibleMedicine/recovery/checkpoints/20261017-studio-reliability-installed');
 const{evidence,note,...source}=data.pendingAtlasSource,{evidence:oldEvidence,note:oldNote,...oldSource}=before.pendingAtlasSource;assert.deepEqual(source,oldSource);assert.equal(evidence,delivery+'/checkpoint.json');
 assert.equal(data.baseline.publicReleaseApproval,null);assert.equal(data.baseline.privateClinicalDecisionCounts,null);
 const rendered=renderChecklist(data);assert(rendered.includes('Revision 38'));for(const text of ['419selected cases','not a whole-suite pass','No new GitHub/off-device backup'])assert(note.includes(text),text);
});

test('revision39 imports only exact arterial evidence limits and preserves the full roadmap',()=>{
 const data=revision39Data;
 assert.equal(data.revision,39);assert.equal(data.updatedAt,'2026-10-17');
 const old=revision38Data,b=data.baseline,p=data.pendingAtlasSource;
 assert.equal(data.items.length,71);assert.equal(data.items.filter(i=>i.scope==='optional').length,8);
 assert.deepEqual(data.changeLog.slice(1),old.changeLog);
 assert.equal(data.changeLog[0].revision,39);
 assert.match(data.changeLog[0].change,/four existing pending placements/i);
 assert.match(data.changeLog[0].change,/radiologist/i);
 assert.match(data.changeLog[0].change,/no clinical or public-release approval/i);
 for(const previous of old.items){
  const current=data.items.find(i=>i.id===previous.id);assert(current,previous.id);
  const {evidence:before,...original}=previous,{evidence:after,...now}=current;
  assert.deepEqual(now,original,'Status, owner, scope and acceptance must stay exact: '+previous.id);
  assert.deepEqual(after,previous.id==='TEACH-04'?[...before,'atlas:docs/ARTERIAL_EVIDENCE_LIMITS.md']:before);
 }
 const changed=['atlasCommit','atlasTree','reviewIntegration','reviewSourceFiles'];
 for(const key of Object.keys(old.baseline))if(!changed.includes(key))assert.deepEqual(b[key],old.baseline[key],key);
 assert.equal(b.atlasCommit,'0ac11ca2eb8effe47f2b6927f7987a9a36c7e3a2');
 assert.equal(b.atlasTree,'0418fa402e7a6586c7d3add78aa92ffe849d343e');
 assert.equal(b.rootTopicPlacements,9936);assert.equal(b.rootDraftPlacements,9314);
 assert.equal(b.rootPendingPlacements,583);assert.equal(b.rootGeneratedIdentificationPlacements,39);
 assert.equal(p.commit,b.atlasCommit);assert.equal(p.tree,b.atlasTree);
 assert.equal(p.websiteImported,true);assert.equal(p.rootDraftPlacements,9314);
 assert.equal(p.rootPendingPlacements,583);assert.equal(p.rootGeneratedIdentificationPlacements,39);
 assert.equal(b.publicReleaseApproval,null);assert.equal(b.privateClinicalDecisionCounts,null);
 const pin=JSON.parse(readFileSync(new URL('./fixtures/head-comparison-before-compact/tests__fixtures__current-atlas-delivery.json',import.meta.url)));
 assert.equal(pin.source,b.atlasCommit);assert.equal(pin.sourceTree,b.atlasTree);
 assert.equal(pin.reviewIntegration,b.reviewIntegration);assert.equal(pin.reviewSourceFiles,b.reviewSourceFiles);
 const source=JSON.parse(readFileSync(new URL('./fixtures/head-comparison-before-compact/atlas-review__manifest.json',import.meta.url)));
 const viewer=JSON.parse(readFileSync(new URL('./fixtures/head-comparison-before-compact/public__atlas-review-viewer__manifest.json',import.meta.url)));
 assert.equal(source.revision,b.atlasCommit);assert.equal(source.files.length,b.reviewSourceFiles);
 assert.equal(source.websiteIntegrationSha256,b.reviewIntegration);
 assert.equal(viewer.sourceCommit,b.atlasCommit);assert.equal(viewer.websiteIntegrationSha256,b.reviewIntegration);
 assert.equal(viewer.mode,'production');assert.equal(viewer.personalRecordsIncluded,false);
 assert.equal(viewer.files.length,pin.viewerFiles);assert.equal(viewer.packages.length,pin.viewerPackages);
 const rendered=renderChecklist(data);assert(rendered.includes('Revision 39'));
 assert(rendered.includes('9314 editorial drafts, 583 pending and 39 generated'));
});
