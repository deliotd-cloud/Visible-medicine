const rawProofs = ['tests/atlas-cerebral-lobar-imaging.test.ts'];

function git(repo, ...args) {
  return execFileSync('git', args, { cwd: repo, encoding: 'utf8', windowsHide: true });
}

function digest(bytes) {
  return createHash('sha256').update(bytes).digest('hex');
}

test('exact Atlas fixtures and source proofs survive Windows checkout conversion', () => {
  // Synthetic names test the policy without requiring any staged production fixture.
  const local = path.join(root, '.local');
  mkdirSync(local, { recursive: true });
  const repo = mkdtempSync(path.join(local, 'exact-fixture-eol-'));
  git(repo, 'init', '-q');
  git(repo, 'config', 'core.autocrlf', 'true');
  git(repo, 'config', 'core.eol', 'crlf');
  copyFileSync(policy, path.join(repo, '.gitattributes'));

  const original = new Map();
  const control = 'tests/eol-unprotected-control.txt';
  for (const name of [...snapshots, ...rawProofs, ...exactProofs, control]) {
    // The actual original and reviewed cerebral source are CRLF and hash-bound.
    const eol = name.includes('cerebral-lobar') ? '\r\n' : '\n';
    const bytes = name === 'tests/fixtures/atlas-hand-vessel-xray.original.mjs'
      ? Buffer.from(`first line for ${name}\nsecond line\r\nthird line\n`)
      : Buffer.from(`first line for ${name}${eol}second line${eol}`);
    const target = path.join(repo, ...name.split('/'));
    mkdirSync(path.dirname(target), { recursive: true });
    writeFileSync(target, bytes);
    original.set(name, digest(bytes));
  }

  for (const name of [...snapshots, ...rawProofs]) {
    assert.equal(git(repo, 'check-attr', 'text', '--', name).trim(), `${name}: text: unset`);
    assert.equal(git(repo, 'check-attr', 'eol', '--', name).trim(), `${name}: eol: unspecified`);
  }
  for (const name of exactProofs) {
    assert.equal(git(repo, 'check-attr', 'text', '--', name).trim(), `${name}: text: set`);
    assert.equal(git(repo, 'check-attr', 'eol', '--', name).trim(), `${name}: eol: lf`);
  }
  assert.equal(git(repo, 'check-attr', 'text', '--', control).trim(), `${control}: text: unspecified`);

  git(repo, 'add', '--', '.gitattributes', ...snapshots, ...rawProofs, ...exactProofs, control);
  for (const name of [...snapshots, ...rawProofs]) {
    const indexBytes = execFileSync('git', ['show', `:${name}`], { cwd: repo, windowsHide: true });
    assert.equal(digest(indexBytes), original.get(name), `snapshot index bytes changed: ${name}`);
  }

  for (const autocrlf of ['true', 'false']) {
    git(repo, 'config', 'core.autocrlf', autocrlf);
    const prefix = `checkout-${autocrlf}/`;
    git(repo, 'checkout-index', '--all', `--prefix=${prefix}`);
    for (const name of [...snapshots, ...rawProofs]) {
      const checkedOut = readFileSync(path.join(repo, prefix, ...name.split('/')));
      assert.equal(digest(checkedOut), original.get(name), `snapshot checkout bytes changed: ${name}`);
      if (name === 'tests/fixtures/atlas-hand-vessel-xray.original.mjs') {
        assert(checkedOut.includes(Buffer.from('\r\n')) && checkedOut.includes(Buffer.from('third line\n')),
          'Mixed line endings remain exact, not rewritten to uniform LF/CRLF');
      }
      if (name.includes('cerebral-lobar')) assert(checkedOut.includes(Buffer.from('\r\n')), 'Reviewed cerebral CRLF bytes must remain exact');
    }
    for (const name of exactProofs) {
      const checkedOut = readFileSync(path.join(repo, prefix, ...name.split('/')));
      assert.equal(digest(checkedOut), original.get(name), `source proof bytes changed: ${name}`);
      assert.equal(checkedOut.includes(Buffer.from('\r\n')), false, `CRLF in exact proof: ${name}`);
    }
    const controlBytes = readFileSync(path.join(repo, prefix, ...control.split('/')));
    if (autocrlf === 'true') {
      assert.equal(controlBytes.includes(Buffer.from('\r\n')), true, 'control did not prove CRLF conversion');
      assert.notEqual(digest(controlBytes), original.get(control));
    }
  }
});
