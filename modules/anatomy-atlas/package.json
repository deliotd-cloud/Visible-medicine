{
  "name": "visible-medicine-anatomy",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "npm run reviews:revisions && vinext build",
    "reviews:revisions": "node scripts/review-revisions.mjs",
    "reviews:test": "node scripts/validate-review.mjs",
    "inspection:test": "node scripts/validate-inspection.mjs",
    "study:test": "node scripts/validate-study-views.mjs",
    "imaging:test": "node scripts/validate-imaging-link.mjs",
    "inventory:audit": "node scripts/audit-anatomy-inventory.mjs",
    "inventory:test": "node scripts/validate-inventory.mjs",
    "neuro:test": "node scripts/validate-neuroanatomy.mjs",
    "axial:test": "node scripts/validate-axial-anatomy.mjs",
    "head-detail:test": "node scripts/validate-head-detail.mjs",
    "practice:test": "node scripts/validate-practice.mjs",
    "dissection-workbench:test": "node scripts/validate-dissection-workbench.mjs",
    "arrangement:test": "node scripts/validate-body-arrangement.mjs",
    "junction:test": "node scripts/validate-junction.mjs && node scripts/validate-junction-study.mjs",
    "mesenteric:test": "node scripts/validate-mesenteric.mjs",
    "pancreatic:test": "node scripts/validate-pancreatic.mjs",
    "thoracic:test": "node scripts/validate-thoracic.mjs",
    "hand-vascular:test": "node scripts/validate-hand-vascular.mjs",
    "hand-venous:test": "node scripts/validate-hand-venous.mjs",
    "foot-vascular:test": "node scripts/validate-foot-vascular.mjs",
    "vessels:test": "node scripts/validate-vessel-colours.mjs",
    "vessel-shapes:audit": "node scripts/audit-vessel-shapes.mjs",
    "vessel-shapes:test": "node scripts/validate-vessel-shapes.mjs",
    "loads:test": "node scripts/validate-anatomy-loading.mjs",
    "guidance:test": "node scripts/validate-dissection-guidance.mjs",
    "ocular-candidates:audit": "node scripts/audit-ocular-candidates.mjs",
    "ocular-candidates:test": "node scripts/validate-ocular-candidates.mjs",
    "ocular:audit": "node scripts/audit-ocular-geometry.mjs",
    "ocular:test": "node scripts/validate-ocular.mjs",
    "laryngeal:audit": "node scripts/audit-laryngeal-anatomy.mjs",
    "laryngeal:test": "node scripts/validate-laryngeal.mjs",
    "renderer:test": "node scripts/validate-scene-recovery.mjs",
    "model-first:test": "node scripts/validate-model-first.mjs",
    "supporting:audit": "node scripts/audit-supporting-candidates.mjs",
    "supporting:test": "node scripts/validate-supporting-candidates.mjs",
    "supporting-geometry:audit": "node scripts/audit-supporting-geometry.mjs",
    "supporting-geometry:test": "node scripts/validate-supporting-geometry.mjs",
    "forearm-vascular:audit": "node scripts/audit-forearm-vascular.mjs",
    "forearm-vascular:test": "node scripts/validate-forearm-vascular.mjs",
    "study-navigation:test": "node scripts/validate-study-navigation.mjs",
    "study-links:test": "node scripts/validate-study-links.mjs",
    "study-library:test": "node scripts/validate-study-library.mjs",
    "inventory:triage": "node scripts/triage-unused-anatomy.mjs",
    "inventory:regional-triage": "node scripts/triage-regional-anatomy.mjs",
    "db:generate": "drizzle-kit generate",
    "db:local": "wrangler d1 migrations apply DB --local --config wrangler.review-local.jsonc",
    "start": "wrangler dev --config dist/server/wrangler.json",
    "lint": "oxlint",
    "format": "oxfmt",
    "licenses:audit": "node scripts/audit-licenses.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react": "^19.2.8",
    "react-day-picker": "9.8.1",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "4.5.8",
    "react-server-dom-webpack": "^19.2.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "three": "^0.185.1",
    "tw-animate-css": "1.4.0",
    "vinext": "^1.0.0-beta.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.4",
    "@cloudflare/workers-types": "^5.20260905.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.34",
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "^8.2.2",
    "wrangler": "^4.129.0"
  },
  "type": "module"
}
