import assert from 'node:assert/strict';import {readFileSync} from 'node:fs';import {execFileSync} from 'node:child_process';import {createHash} from 'node:crypto';
import {build} from './workspace-test-build.mjs';import {exactSourceHistoryApi} from './exact-source-history-api.mjs';
assert.equal(process.argv.length,2,'No test-mode flags');
const baseline='bc925194ce3b388d4b6d9f73b4b3362ed4f2ad5f',git=args=>execFileSync('git',args,{encoding:'utf8',windowsHide:true,maxBuffer:64e6,env:{...process.env,GIT_NO_REPLACE_OBJECTS:'1'}}),sha=bytes=>createHash('sha256').update(bytes).digest('hex');
const pins=JSON.parse(readFileSync('content/arterial-evidence-limits-pins.json','utf8'));assert.equal(pins.baseline,baseline);
const raw=JSON.parse(readFileSync('public/models/bodyparts3d/full-body/catalog.json','utf8')),oldRaw=JSON.parse(git(['show',baseline+':public/models/bodyparts3d/full-body/catalog.json']));
const compiled=await build({stdin:{contents:`export {bodyLesson,bodyContent} from './app/body-content';export {bodyDisplayCatalog} from './lib/body-display-catalog';export {contentTabs} from './lib/content-types';export {structures} from './app/anatomy-data';export {dissectionProfiles} from './app/dissection-data';export {regionalTours} from './lib/regional-tours';export {arterialEvidenceLimitLesson} from './lib/arterial-evidence-limits';export {arterialEvidenceLimits} from './content/arterial-evidence-limits';export * from './lib/body-review-material';export * from './lib/body-review-context';export * from './lib/body-review-response';export * from './lib/body-review-api';export * from './lib/body-review-decisions';`,resolveDir:process.cwd(),loader:'ts'},bundle:true,write:false,platform:'node',format:'esm'});
const live=await import('data:text/javascript;base64,'+Buffer.from(compiled.outputFiles[0].text).toString('base64'));
const before=await exactSourceHistoryApi(baseline,'review-security'),working=git(['rev-parse','HEAD']).trim()===baseline;
let introduction=null,feature=live;
if(!working){introduction=git(['log','--diff-filter=A','--format=%H','--','lib/arterial-evidence-limits.ts']).trim().split(/\r?\n/).at(-1);assert.match(introduction,/^[a-f0-9]{40}$/);assert.equal(git(['rev-parse',introduction+'^']).trim(),baseline);assert.equal(git(['merge-base',introduction,'HEAD']).trim(),introduction);feature=await exactSourceHistoryApi(introduction,'review-security');}
const oldCatalog=before.bodyDisplayCatalog(oldRaw),featureCatalog=feature.bodyDisplayCatalog(oldRaw),currentCatalog=live.bodyDisplayCatalog(raw);
assert.deepEqual(featureCatalog,oldCatalog,'Exact introduction changes no catalogue identity/geometry');assert.equal(featureCatalog.structures.length,1104);
for(const key of ['structures','dissectionProfiles','regionalTours','contentTabs'])assert.deepEqual(feature[key],before[key],key+' unchanged in immutable transition');
const expected=[['FMA23125','left','FJ2331','dba9052edb17c903439ef8817e27618d4d1fbf8d3887bc56d6e9ff13474a4d2e','ultrasound'],['FMA23124','right','FJ2362','53b2658acb8350ceb12d76c0c0ad73a9235e708b55b9543a866846a61e8fbdff','ultrasound'],['FMA10680','left','FJ2210','b2a14e4d5558ba3132f99b12b09721fac476fa8997013e1e463229bd5c15c8e8','mri'],['FMA10697','right','FJ2209','229bf9cfcf4a5ba6f8bedf79e17cf395dd6c6c3290cef1ac2519012a0305eed4','mri']];
assert.equal(pins.entries.length,4);assert.equal(pins.bundles.length,2);
for(const [fmaId,side,file,digest,tab]of expected){const entry=pins.entries.find(e=>e.identity.fmaId===fmaId);assert(entry);assert.equal(entry.tab,tab);assert.equal(entry.identity.laterality,side);assert.deepEqual(entry.identity.sources,[{file,sha256:digest}]);assert.equal(entry.identity.validation.status,'unvalidated');assert.equal(entry.identity.validation.anatomicalReview,false);assert.deepEqual(currentCatalog.structures.filter(s=>s.id===entry.identity.id),[entry.identity]);assert.deepEqual(oldCatalog.structures.filter(s=>s.id===entry.identity.id),[entry.identity]);assert.deepEqual(before.bodyLesson(entry.identity,tab),entry.previous);}
for(const bundle of pins.bundles){const p='public'+new URL(bundle.url,'https://local.invalid').pathname;assert.equal(sha(readFileSync(p)),bundle.sha256);assert.equal(readFileSync(p).length,bundle.bytes);}
const selected=new Map(pins.entries.map(e=>[e.identity.id,e.tab]));let changed=0,preserved=0;
for(const structure of featureCatalog.structures)for(const tab of feature.contentTabs){const previous=before.bodyLesson(structure,tab),lesson=feature.bodyLesson(structure,tab);if(selected.get(structure.id)===tab){assert.notDeepEqual(lesson,previous);assert.equal(lesson.readiness,'pending','Missing modality evidence must not become draft/approved');assert.match(lesson.title,/evidence pending/);assert.match(lesson.note,/sign-off remain pending/);changed++;}else{assert.deepEqual(lesson,previous,structure.id+':'+tab);preserved++;}}
assert.deepEqual([changed,preserved],[4,9932]);
const pinPath='content/body-review-display-pins.json',oldDisplayPins=JSON.parse(git(['show',baseline+':'+pinPath]));
const newDisplayPins=working?JSON.parse(readFileSync(pinPath,'utf8')):JSON.parse(git(['show',introduction+':'+pinPath]));
assert.equal(newDisplayPins.pins.length,oldDisplayPins.pins.length);let changedDisplayPins=0;
for(const pin of oldDisplayPins.pins){const next=newDisplayPins.pins.find(row=>row.structureId===pin.structureId);assert(next);if(selected.has(pin.structureId)){assert.notEqual(next.sha256,pin.sha256);changedDisplayPins++;}else assert.deepEqual(next,pin,'Unrelated Review display pin changed');}
assert.equal(changedDisplayPins,4);
const middle=live.arterialEvidenceLimits.middleCollateralUltrasound,thyroid=live.arterialEvidenceLimits.inferiorThyroidMri;
assert.match(middle.body,/Cadaveric anatomy cannot establish routine ultrasound visibility/);assert.match(middle.bullets.join(' '),/not direct middle collateral validation/);assert.deepEqual(middle.citations,['https://pubmed.ncbi.nlm.nih.gov/14730394/','https://pubmed.ncbi.nlm.nih.gov/26969598/']);
assert.match(thyroid.body,/aneurysmal/);assert.match(thyroid.body,/does not establish normal-artery visibility/);assert.match(thyroid.bullets.join(' '),/Do not transfer the MRA case finding/);assert.deepEqual(thyroid.citations,['https://www.ajemjournal.com/article/S0735-67571500051-0/fulltext']);
function leaves(value,path=[]){if(value&&typeof value==='object')return Object.entries(value).flatMap(([key,next])=>leaves(next,[...path,key]));return[{path,value}];}
function change(root,path,value){let target=root;for(const key of path.slice(0,-1))target=target[key];target[path.at(-1)]=value;}
let refusedIdentities=0,malformedPackets=0,staleRefusals=0,storageCalls=0;
for(const entry of pins.entries){const s=entry.identity,tab=entry.tab,lesson=live.arterialEvidenceLimitLesson(s,tab);assert(lesson);assert.deepEqual(live.bodyLesson(s,tab),lesson);const{readiness,...section}=lesson;assert.deepEqual(live.bodyContent(s,tab),section);
 for(const other of live.contentTabs.filter(t=>t!==tab))assert.equal(live.arterialEvidenceLimitLesson(s,other),undefined);
 for(const{path,value}of leaves(s)){const forged=structuredClone(s);change(forged,path,typeof value==='string'?value+' foreign':typeof value==='number'?value+1:typeof value==='boolean'?!value:'foreign');assert.equal(live.arterialEvidenceLimitLesson(forged,tab),undefined,'Changed leaf '+path.join('.'));refusedIdentities++;}
 const extra={...s,foreign:true};assert.equal(live.arterialEvidenceLimitLesson(extra,tab),undefined);refusedIdentities++;
 const first=live.arterialEvidenceLimitLesson(s,tab);first.bullets.push('foreign');first.citations.push('https://foreign.invalid');assert.deepEqual(live.arterialEvidenceLimitLesson(s,tab),lesson,'Consumer edits cannot mutate shared content');
 const oldPacket=await before.bodyReviewMaterial(s.id),packet=await live.bodyReviewMaterial(s.id);assert.deepEqual(await live.parseBodyReviewResponse(packet,s.id),packet);assert.equal(await live.parseBodyReviewResponse(oldPacket,s.id),null);assert.deepEqual(packet.topics.find(t=>t.tab===tab),{tab,...lesson});
 for(const edit of [p=>{p.topics.find(t=>t.tab===tab).body+=' foreign';},p=>{p.topics.find(t=>t.tab===tab).readiness='draft';},p=>{p.source.structure.sources[0].sha256='0'.repeat(64);},p=>{p.topics.find(t=>t.tab===tab).citations=['https://foreign.invalid'];}]){const forged=structuredClone(packet);edit(forged);assert.equal(await live.parseBodyReviewResponse(forged,s.id),null);malformedPackets++;}
 const oldContext=await before.bodyReviewContext(s.id),context=await live.bodyReviewContext(s.id);assert.equal(context.sourceHash,oldContext.sourceHash);assert.notEqual(context.revisions.teaching,oldContext.revisions.teaching);
 const decision={catalogScope:context.catalogScope,structureId:s.id,track:'teaching',expectedVersion:0,materialHash:oldContext.materialHash,revisionHash:oldContext.revisions.teaching,checklistVersion:context.checklistVersion,draft:live.blankBodyReview(context,'teaching')};
 const request=body=>new Request('https://atlas.test/api/body-decisions',{method:'POST',headers:{origin:'https://atlas.test','content-type':'application/json','oai-authenticated-user-id':'SYNTHETIC_EVIDENCE_LIMITS'},body:JSON.stringify(body)}),db={prepare(){storageCalls++;throw Error('Invalid request reached storage');}};
 assert.equal((await live.postBodyDecision(request(decision),db)).status,409);staleRefusals++;
}
assert.equal(storageCalls,0);console.log(JSON.stringify({baseline,introduction,working,changed,preserved,changedDisplayPins,readinessPromotions:0,refusedIdentities,malformedPackets,staleRefusalsBeforeStorage:staleRefusals,storageCalls,geometryChanged:false,clinicalApproval:false}));
