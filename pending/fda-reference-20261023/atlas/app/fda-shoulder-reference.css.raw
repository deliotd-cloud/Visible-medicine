.fda-reference{--fda-ink:#123b42;--fda-muted:#577277;color:var(--fda-ink);background:#f5f8f6;font-family:Arial,Helvetica,sans-serif;max-width:1600px;margin:0 auto;padding:24px;box-sizing:border-box}
@media(min-width:1001px){.fda-reference .fda-reference-grid{height:calc(100dvh - 164px);min-height:490px;max-height:900px}.fda-reference .fda-reference-parts,.fda-reference .fda-reference-info{overflow-y:auto}.fda-reference .fda-reference-main{display:flex;flex-direction:column}.fda-reference .fda-reference-canvas{flex:1;height:auto;min-height:320px}.fda-reference .fda-reference-toolbar,.fda-reference .fda-reference-help{flex-shrink:0}}
.fda-reference *{box-sizing:border-box}.fda-reference-heading{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:20px}.fda-reference h1{font-size:30px;letter-spacing:-1px;margin:7px 0}.fda-reference h2{font-size:22px;letter-spacing:-.5px;line-height:1.25;margin:10px 0 14px}.fda-reference p{line-height:1.55;font-size:14px;margin:8px 0}.fda-reference-heading p{color:var(--fda-muted)}.fda-reference-eyebrow{font-size:10px;font-weight:700;letter-spacing:1.5px;color:#4c7778}.fda-reference-badge{white-space:nowrap;border:1px solid #dccb9e;background:#fff8e7;color:#705919;padding:7px 10px;border-radius:6px;font-size:12px}.fda-reference-grid{display:grid;grid-template-columns:205px minmax(280px,1fr) 240px;border:1px solid #d4e0d9;border-radius:12px;overflow:hidden;background:white}.fda-reference-parts{padding:19px 12px;border-right:1px solid #dce5df}.fda-reference label{font-size:12px;font-weight:700;display:block;margin:0 5px 9px}.fda-reference input{width:100%;border:1px solid #b9cfc8;border-radius:6px;padding:10px;color:var(--fda-ink);font:inherit;font-size:12px}.fda-reference-muted{color:var(--fda-muted);font-size:11px!important}.fda-reference-parts>.fda-reference-muted{padding:0 5px}.fda-reference-list{display:grid;gap:5px;margin-top:13px}.fda-reference button{font:inherit;cursor:pointer;border:1px solid #cadbd3;background:#fff;color:var(--fda-ink);border-radius:6px;padding:8px 10px;font-size:12px}.fda-reference button:disabled{opacity:.45;cursor:default}.fda-reference button[aria-pressed=true]{border-color:#237b7b;background:#e8f4ed}.fda-reference button:focus-visible,.fda-reference input:focus-visible,.fda-reference summary:focus-visible,.fda-reference a:focus-visible{outline:3px solid #e9a23c;outline-offset:3px}.fda-reference-list button{display:flex;text-align:left;align-items:flex-start;gap:9px;line-height:1.4;border-color:transparent;padding:10px 8px}.fda-reference-list button small{display:block;color:var(--fda-muted);font-size:10px;margin-top:4px}.fda-reference-dot{width:9px;height:9px;border-radius:50%;flex-shrink:0;margin-top:4px;border:1px solid #0002}.fda-reference-main{min-width:0;background:#092630}.fda-reference-toolbar{display:flex;justify-content:space-between;align-items:center;gap:7px;background:#fff;padding:11px;border-bottom:1px solid #dce5df;flex-wrap:wrap}.fda-reference-toolbar>div{display:flex;gap:5px}.fda-reference-toolbar button{padding:7px 9px;font-size:11px}.fda-reference-canvas{position:relative;height:510px;min-height:350px;color:#d9eeea;display:flex;align-items:center;justify-content:center;overflow:hidden}.fda-reference-canvas>div[role=alert]{max-width:380px;padding:24px}.fda-reference-canvas-caption{position:absolute;bottom:14px;left:16px;right:16px;font-size:10px;color:#a7c9c8;pointer-events:none}.fda-reference-help{font-size:10px;line-height:1.5;padding:11px 16px;color:#b0cfca;border-top:1px solid #ffffff12}.fda-reference-info{padding:22px 18px;border-left:1px solid #dce5df}.fda-reference-info p{font-size:12px}.fda-reference-info dl{font-size:11px;margin:18px 0;display:grid;grid-template-columns:1fr;gap:5px}.fda-reference-info dt{color:var(--fda-muted);font-size:10px;margin-top:5px}.fda-reference-info dd{margin:0;line-height:1.5}.fda-reference-note{background:#f0f6f2;border-left:3px solid #7fa996;padding:12px;margin:20px 0;font-size:12px}.fda-reference summary{font-size:12px;font-weight:700;cursor:pointer;line-height:1.5}.fda-reference details{padding:12px 0}.fda-reference-hold{margin:16px 5px 0;border-top:1px solid #dce5df}.fda-reference-hold p{font-size:11px}.fda-reference a{color:#116d73;font-size:12px}.fda-reference-code{overflow-wrap:anywhere;font-family:monospace;font-size:10px!important}@media(min-width:1450px){.fda-reference-grid{grid-template-columns:225px minmax(400px,1fr) 270px}.fda-reference-canvas{height:600px}}@media(max-width:1000px){.fda-reference-grid{grid-template-columns:190px minmax(260px,1fr)}.fda-reference-info{grid-column:1/-1;border-left:0;border-top:1px solid #dce5df}.fda-reference-canvas{height:460px}}@media(max-width:600px){.fda-reference{padding:10px}.fda-reference-heading{align-items:flex-start;gap:10px}.fda-reference h1{font-size:25px}.fda-reference-heading p{font-size:12px}.fda-reference-grid{display:flex;flex-direction:column}.fda-reference-main{order:-1}.fda-reference-canvas{height:390px}.fda-reference-parts{border:0}.fda-reference-list{grid-template-columns:1fr 1fr}.fda-reference-badge{font-size:10px;padding:6px}.fda-reference-toolbar{gap:5px}}
