import assert from 'node:assert/strict';import test from 'node:test';import {readFileSync} from 'node:fs';import {createHash} from 'node:crypto';
import {readRevision53,validateRevision53Delivery} from './historical-head-manual-recovery-delivery-53.mjs';const validateCurrentAtlasDelivery=validateRevision53Delivery;import {revision52,revision52Supplement,readRevision52,validateRevision52Delivery} from './historical-native-head-history-delivery-52.mjs';
import {validateCurrentAtlasDelivery as validateLiveAtlasDelivery} from './current-atlas-delivery.mjs';
const read=p=>readRevision53(p),sha=b=>createHash('sha256').update(b).digest('hex'),json=p=>JSON.parse(read(p)),replace=(s,a,b)=>{assert.equal(s.split(a).length,2,a);return s.replace(a,b);};
test('closed52 retains every original byte and only declared historical read seams migrate',()=>{
 assert.equal(revision52.files.length,22);for(const row of revision52.files)assert.equal(sha(readRevision52(row.path)),row.sha256,row.path);
 assert.equal(revision52Supplement.files.length,1);for(const row of revision52Supplement.files)assert.equal(sha(readRevision52(row.path)),row.sha256,row.path);let helper50=readRevision52('tests/historical-lacrimal-delivery-50.mjs').toString();assert.equal(sha(Buffer.from(helper50)),'c6ae216d636c46cfea02e6ebc90d91ad0d99794c008e1feeeb24fe1ae5de3052');helper50=replace(helper50,"if(!row&&path==='atlas-review/content/regional-teaching/abdomen.json')return readRevision51(path);","if(!row&&['atlas-review/content/regional-teaching/abdomen.json','components/HeadAtlasViewer.tsx','scripts/bind-clinical-review.mjs'].includes(path))return readRevision51(path);");assert.deepEqual(read('tests/historical-lacrimal-delivery-50.mjs'),Buffer.from(helper50));
 let helper=readRevision52('tests/historical-radial-eus-delivery-51.mjs').toString();helper=replace(helper,"import {validateCurrentAtlasDelivery} from './current-atlas-delivery.mjs';","import {validateCurrentAtlasDelivery} from './current-atlas-delivery.mjs';\nimport {readRevision52} from './historical-native-head-history-delivery-52.mjs';");helper=replace(helper,'const row=records.get(path);if(!row)',"const row=records.get(path);if(!row&&['components/HeadAtlasViewer.tsx','scripts/bind-clinical-review.mjs'].includes(path))return readRevision52(path);if(!row)");assert.deepEqual(read('tests/historical-radial-eus-delivery-51.mjs'),Buffer.from(helper));
 let radial=readRevision52('tests/radial-eus-current-transition.test.mjs').toString();radial=replace(radial,"\nimport {currentAtlasDeliveryRoot,validateCurrentAtlasDelivery} from './current-atlas-delivery.mjs';\n","\nimport {currentAtlasDeliveryRoot} from './current-atlas-delivery.mjs';\nimport {readRevision52,validateRevision52Delivery} from './historical-native-head-history-delivery-52.mjs';\nconst validateCurrentAtlasDelivery=validateRevision52Delivery;\n");radial=replace(radial,"read=p=>readFileSync(new URL('../'+p,import.meta.url))","read=p=>readRevision52(p)");const radialPost52=readFileSync(new URL('./fixtures/head-native-radial-eus-post52.mjs.raw',import.meta.url));assert.equal(sha(radialPost52),'04362adbf0d1ef51063e3943fc60b8d9693d7613a29349af2183ab1440670847');assert.deepEqual(radialPost52,Buffer.from(radial),'All original52 assertions remain');
 const old51=JSON.parse(read('tests/fixtures/radial-eus-51/epoch.json')),inputsRow=old51.files.find(r=>r.path==='atlas-review/integration-inputs.json');assert(inputsRow);const inputsBytes=read('tests/fixtures/radial-eus-51/'+inputsRow.storagePath);assert.equal(sha(inputsBytes),inputsRow.sha256);const inputs51=JSON.parse(inputsBytes);for(const p of revision52.changedPriorInputs)assert.equal(inputs51.inputs.find(r=>r.path===p)?.sha256,sha(readRevision52(p)),p+' genuinely unchanged51-to52 preimage');
 assert.equal(validateRevision52Delivery().reviewIntegration,revision52.review);assert.throws(()=>validateCurrentAtlasDelivery({pin:validateRevision52Delivery()}));
});
test('actual current6d7 delivery retains independent 190a runtimes without treating closed53 as current',()=>{
 const live=validateLiveAtlasDelivery();assert.equal(live.source,'6d7a356ae949e13f2ff4bf1fec610ee6ae7762c1');assert.equal(live.sourceTree,'e9165d7122361f809a267af1414b337b69097fe2');assert.equal(live.reviewIntegration,'525f8fbe122bf6bdc15d8b89f572e49e3ac0ce09cd411b8009f67454d938a163');assert.equal(live.reviewSourceFiles,1558);
 assert.equal(live.runtimeSources['head-neck'],live.source);for(const module of ['shoulder','lower-limb','female-pelvis'])assert.equal(live.runtimeSources[module],'190a63238eadcf906abe89dcbb6a67c88afe70b9',module+' retained runtime source');
 assert.throws(()=>validateLiveAtlasDelivery({pin:validateRevision53Delivery()}));
 const helper=readFileSync(new URL('../lib/head-view-history.ts',import.meta.url),'utf8');assert.doesNotMatch(helper,/localStorage|sessionStorage|indexedDB|fetch\(/);assert.match(helper,/export function createHeadViewHistory\(limit=64/);assert.match(helper,/freshExternalState/);assert.match(helper,/HEAD_VIEW_EXTERNAL_HISTORY_KEY/);
});
test('current53 changes only the two website inputs and new memory helper, retaining all71/eight requirements',()=>{
 const current=validateCurrentAtlasDelivery(),before=JSON.parse(readRevision52('docs/completion-checklist.json')),now=json('docs/completion-checklist.json');assert.equal(before.revision,52);assert.equal(now.revision,53);assert.equal(now.items.length,71);assert.equal(now.items.filter(r=>r.scope==='optional').length,8);for(const key of ['items','statusDefinitions','rules','roots','pendingAtlasSource'])assert.deepEqual(now[key],before[key],key);assert.deepEqual(now.changeLog.slice(1),before.changeLog);for(const[k,v]of Object.entries(before.baseline))if(k!=='reviewIntegration')assert.deepEqual(now.baseline[k],v,k);
 assert.equal(current.source,revision52.source);assert.equal(current.sourceTree,revision52.sourceTree);assert.notEqual(current.reviewIntegration,revision52.review);assert.equal(now.baseline.reviewIntegration,current.reviewIntegration);assert.equal(now.baseline.privateClinicalDecisionCounts,null);assert.equal(now.baseline.publicReleaseApproval,null);
 const oldInputs=JSON.parse(readRevision52('atlas-review/integration-inputs.json')),inputs=json('atlas-review/integration-inputs.json'),map=new Map(oldInputs.inputs.map(r=>[r.path,r.sha256]));assert.equal(inputs.inputs.length,1658);assert.deepEqual(inputs.inputs.filter(r=>!map.has(r.path)).map(r=>r.path),['lib/head-view-history.ts']);assert.deepEqual(inputs.inputs.filter(r=>map.has(r.path)&&map.get(r.path)!==r.sha256).map(r=>r.path),revision52.changedPriorInputs);for(const row of inputs.inputs)assert.equal(sha(read(row.path)),row.sha256,row.path);assert.equal(sha(JSON.stringify(inputs.inputs)),current.reviewIntegration);assert.deepEqual(json('lib/atlas-model-inventory.json'),JSON.parse(readRevision52('lib/atlas-model-inventory.json')));
 let admission=readRevision52('tests/current-atlas-delivery.test.mjs').toString();admission=replace(admission,revision52.review,current.reviewIntegration);assert.deepEqual(read('tests/current-atlas-delivery.test.mjs'),Buffer.from(admission));
 const previousManifest=JSON.parse(readRevision52('atlas-review/manifest.json')),manifest=json('atlas-review/manifest.json');assert.equal(manifest.files.length,1528);for(const row of previousManifest.files)if(!['content/body-renderer-revision.json','content/review-revisions.json'].includes(row.path))assert.deepEqual(manifest.files.find(r=>r.path===row.path),row,row.path);
});
test('admitted native-history implementation remains the reviewed bounded-memory handoff without storage or coordinate links',()=>{
 const handoff=json('tests/fixtures/native-head-history-52/head-view-history-handoff.json');assert.equal(handoff.schema,'vm-exact-uninstalled-handoff-source-1');assert.equal(handoff.path,'lib/head-view-history.ts');assert.equal(Buffer.byteLength(handoff.text),handoff.bytes);assert.equal(sha(Buffer.from(handoff.text)),'44b572a05fd154088f59c07cdaab36fbbb7860e7d824b4b2e7c1b5234ce8ee11');const expected=replace(handoff.text,'const old=tokenFrom(state),known=old&&entries.get(old);','const old=tokenFrom(state),known=old?entries.get(old):undefined;');assert.equal(read('lib/head-view-history.ts').toString().replaceAll('\r\n','\n'),expected.replaceAll('\r\n','\n'));assert.equal(sha(read('components/HeadAtlasViewer.tsx')),'06b4c293f5931f5cd0e36471de46718c6bbf26ea3500ec24c57c4de15e476841');
 const helper=read('lib/head-view-history.ts').toString();assert.doesNotMatch(helper,/localStorage|sessionStorage|indexedDB|fetch\(/);assert.match(helper,/new Map<string,Receipt>/);assert.match(helper,/createHeadViewHistory\(limit=64/);assert.match(helper,/freshExternalState/);assert.match(helper,/HEAD_VIEW_EXTERNAL_HISTORY_KEY/);
});
