// Dedicated synthetic browser fixture, never a Website route or auth adapter.
import React from 'react';import {createRoot} from 'react-dom/client';import {ClinicalReviewInbox} from 'vm-exact-review-inbox';
const entries=Array.from({length:60},(_,i)=>({key:'synthetic-'+i,title:'Synthetic anatomy structure '+String(i+1).padStart(2,'0'),area:'structures',scopeLabel:'Synthetic body region',href:'/workspace/atlas-review/body?fixture='+i,trackLabel:'Anatomy',revision:'c'.repeat(64),status:i%3===0?'re-review':'not-started',capability:'decision',...(i%3===0?{changeReason:'source-or-teaching'}:{})}));
window.fetch=async(input,init={})=>{const url=new URL(String(input),location.href);if(url.origin!==location.origin||url.pathname!=='/api/atlas-review/inbox'||url.search!=='?page=1'||(init.method??'GET')!=='GET')throw Error('Synthetic specimen refuses network access');if(init.signal?.aborted)throw new DOMException('Aborted','AbortError');return Response.json({schema:'vm-clinical-inbox-1',scope:'private-to-signed-in-account-and-institution',catalogRevision:'b'.repeat(64),page:1,pageCount:1,selectionTotal:entries.length,nextPage:null,items:entries,approval:false},{headers:{'X-Clinical-Review-Context':'a'.repeat(64)}});};
document.addEventListener('click',event=>{if(event.target instanceof Element&&event.target.closest('a'))event.preventDefault();},true);createRoot(document.getElementById('app')).render(<ClinicalReviewInbox/>);
