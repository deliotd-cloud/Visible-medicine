body{margin:0;background:#eff5f2;color:#12363c;font:16px system-ui}main{max-width:1000px;margin:25px auto;padding:0 20px}h1{font-size:24px}.qa-controls{display:flex;gap:12px;flex-wrap:wrap}.qa-controls output{flex-basis:100%;padding:8px}button{font:inherit;padding:8px;cursor:pointer}.head-view{margin-top:18px;background:#061e24;height:540px;--imaging-ink:#eef6f2;--imaging-muted:#b4c9c4;--imaging-line:#476a64}.head-slice-area{height:380px!important;position:relative;flex:none}.head-view header,.head-slice-footer,.head-slice-help{flex:none}
