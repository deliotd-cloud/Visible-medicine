:root{--teal:#087b6c;--ink:#132c32;--muted:#526569;--line:#c4d4d1}*{box-sizing:border-box}body{margin:0;font:16px/1.5 system-ui;background:#f8fbfa;color:var(--ink)}header{padding:18px 28px;border-bottom:1px solid var(--line);background:#eef5f2}header p{margin:6px 0;max-width:90ch}.fixture-layout{display:grid;grid-template-columns:220px minmax(0,1fr);gap:32px;margin:24px auto;max-width:1100px}.fixture-layout aside{padding:18px;border:1px solid var(--line);border-radius:10px;background:#edf5f2}.fixture-layout section{min-width:0}h1{margin-top:0}button{padding:9px 14px;margin:0 8px 12px 0;border:1px solid var(--teal);border-radius:6px;background:white;color:var(--teal);font:inherit;cursor:pointer}a{text-decoration:none}textarea{display:block;max-width:100%;width:440px;min-height:100px;padding:10px;font:inherit;border:1px solid var(--line);margin:8px 0}label{display:block}button:focus-visible,textarea:focus-visible{outline:3px solid var(--teal);outline-offset:3px}
