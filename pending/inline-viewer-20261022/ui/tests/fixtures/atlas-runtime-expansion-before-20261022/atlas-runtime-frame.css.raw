.atlas-3d-workspace-page .atlas-runtime-frame {
  position: relative;
  flex: 1;
  min-height: 280px;
  min-width: 0;
}
.atlas-runtime-frame:focus { outline: 3px solid #16c6b2; outline-offset: -3px; }
.atlas-runtime-frame > iframe {
  position: absolute;
  inset: 0;
  display: block;
  width: 100%;
  height: 100%;
  min-height: 0;
}
.atlas-runtime-status,
.atlas-runtime-help {
  position: absolute;
  z-index: 1;
  max-width: min(440px, calc(100% - 24px));
  padding: 9px 12px;
  border: 1px solid #b8cbc6;
  border-radius: 8px;
  color: #16332d;
  background: #f8f7f2f2;
  font: 13px/1.4 system-ui, sans-serif;
  box-shadow: 0 2px 12px #07121020;
}
.atlas-runtime-status { top: 12px; left: 12px; }
.atlas-runtime-help { bottom: 12px; right: 12px; }
.atlas-runtime-help summary { cursor: pointer; }
.atlas-runtime-help summary:focus-visible { outline: 3px solid #16c6b2; outline-offset: 3px; }
.atlas-runtime-help[open] { width: min(360px, calc(100% - 24px)); }
.atlas-runtime-help p { margin: 8px 0; }
.atlas-runtime-status-confirmed {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}
.atlas-runtime-actions { display: flex; flex-wrap: wrap; gap: 8px 14px; margin-top: 7px; align-items: center; }
.atlas-runtime-actions button { border: 1px solid #36786e; border-radius: 5px; padding: 4px 8px; background: #fff; color: #17483f; cursor: pointer; font: inherit; }
.atlas-runtime-actions a { color: #145f70; }
.atlas-runtime-actions :is(button, a):focus-visible { outline: 3px solid #16c6b2; outline-offset: 3px; }
@media (min-width: 1200px) {
  .anatomy-site-frame .atlas-3d-workspace-page .atlas-runtime-frame { grid-column: 1; grid-row: 3; }
}
@media (max-height: 650px) {
  .atlas-3d-workspace-page .atlas-runtime-frame { flex: none; height: 70dvh; min-height: 380px; }
}
